# Copy this file to .env and replace the placeholder values.
# For AWS deployment, set DB_HOST to the RDS endpoint.
DB_HOST=localhost
DB_NAME=trabalho-cloud
DB_USER=postgres
DB_PASS=change-me
DB_PORT=5432

# Use 0.0.0.0 on EC2 so the app can receive network traffic.
# Use 127.0.0.1 to limit access to the local machine.
FLASK_HOST=0.0.0.0

# Enable only for local development; keep false in production.
FLASK_DEBUG=false
